<?xml version="1.0" ?>
<!--
  巡回タスク用ワールド (Ignition Gazebo Fortress / SDF 1.8)
  - 差動二輪ロボット diffbot (DiffDrive プラグイン + GPU LiDAR + 搭載カメラ)
  - 障害物 4 個、目標地点マーカー A/B/C、ホーム H
  - 俯瞰カメラ (動画記録用)
  アリーナ: x ∈ [-1, 7], y ∈ [-4, 4]  ロボット初期位置 (0, 0, yaw=0)
-->
<sdf version="1.8">
  <world name="patrol_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ===== 地面 ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.55 0.6 0.55 1</ambient>
            <diffuse>0.55 0.6 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== アリーナの壁 (高さ 0.4 m) ===== -->
    <model name="walls">
      <static>true</static>
      <pose>3 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="north_c"><pose>0 4 0 0 0 0</pose><geometry><box><size>8.2 0.1 0.4</size></box></geometry></collision>
        <visual name="north_v"><pose>0 4 0 0 0 0</pose><geometry><box><size>8.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -4 0 0 0 0</pose><geometry><box><size>8.2 0.1 0.4</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -4 0 0 0 0</pose><geometry><box><size>8.2 0.1 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="east_c"><pose>4 0 0 0 0 0</pose><geometry><box><size>0.1 8 0.4</size></box></geometry></collision>
        <visual name="east_v"><pose>4 0 0 0 0 0</pose><geometry><box><size>0.1 8 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="west_c"><pose>-4 0 0 0 0 0</pose><geometry><box><size>0.1 8 0.4</size></box></geometry></collision>
        <visual name="west_v"><pose>-4 0 0 0 0 0</pose><geometry><box><size>0.1 8 0.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== 障害物 (経路上にわざと配置) ===== -->
    <model name="obstacle_box1">
      <static>true</static>
      <pose>2.5 -1.05 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.6 0.35 0.2 1</ambient><diffuse>0.6 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_cyl1">
      <static>true</static>
      <pose>5.4 0.1 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.7 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_box2">
      <static>true</static>
      <pose>3.5 2.65 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.9 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.9 0.5</size></box></geometry>
          <material><ambient>0.6 0.35 0.2 1</ambient><diffuse>0.6 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_cyl2">
      <static>true</static>
      <pose>0.85 1.15 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.7 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== 目標地点マーカー (薄い円盤: LiDAR には映らない高さ) ===== -->
    <model name="marker_home">
      <static>true</static><pose>0 0 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link>
    </model>
    <model name="marker_a">
      <static>true</static><pose>5 -2.5 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.9 0.15 0.15 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="marker_b">
      <static>true</static><pose>5.5 2.5 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.15 0.75 0.2 1</ambient><diffuse>0.15 0.75 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="marker_c">
      <static>true</static><pose>1.5 2.5 0.003 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- ===== 俯瞰カメラ (動画記録用) ===== -->
    <model name="overview_camera">
      <static>true</static>
      <pose>3 -8.3 7.2 0 0.72 1.5708</pose>
      <link name="link">
        <sensor name="overview_cam" type="camera">
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <topic>overview_camera</topic>
        </sensor>
      </link>
    </model>

    <!-- ===== ロボット本体: diffbot ===== -->
    <model name="diffbot">
      <pose>0 0 0 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.0167</ixx><iyy>0.0283</iyy><izz>0.0417</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="body_c"><geometry><box><size>0.40 0.30 0.10</size></box></geometry></collision>
        <visual name="body_v"><geometry><box><size>0.40 0.30 0.10</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material></visual>
        <!-- 前方の向きが分かるように頭部パーツ -->
        <visual name="head_v"><pose>0.15 0 0.07 0 0 0</pose><geometry><box><size>0.08 0.20 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <!-- キャスター: 摩擦ゼロの球を固定 (ball joint より安定) -->
        <collision name="caster_c">
          <pose>0.15 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_v"><pose>0.15 0 -0.06 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>

        <!-- 2D LiDAR (360°) -->
        <visual name="lidar_v"><pose>0.0 0 0.08 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.0 0 0.12 0 0 0</pose>
          <topic>scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan><horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
          </lidar>
          <always_on>1</always_on>
          <visualize>false</visualize>
        </sensor>

        <!-- 搭載カメラ (ロボット目線) -->
        <sensor name="onboard_cam" type="camera">
          <pose>0.2 0 0.08 0 0.1 0</pose>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>onboard_camera</topic>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>-0.05 0.18 0.08 -1.5707 0 0</pose>
        <inertial><mass>0.3</mass>
          <inertia><ixx>0.00052</ixx><iyy>0.00052</iyy><izz>0.00096</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose>-0.05 -0.18 0.08 -1.5707 0 0</pose>
        <inertial><mass>0.3</mass>
          <inertia><ixx>0.00052</ixx><iyy>0.00052</iyy><izz>0.00096</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- 差動二輪駆動 (記事と同じ DiffDrive プラグイン) -->
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
