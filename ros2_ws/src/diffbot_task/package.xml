<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diffbot_task</name>
  <version>1.0.0</version>
  <description>ROS 2 + Gazebo: 差動二輪ロボットの自律巡回を模倣学習 (Behavior Cloning) で学習・デプロイする</description>
  <maintainer email="student@example.com">student</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <!-- 学習 (train_bc) のみ PyTorch が必要: pip3 install torch (setup/install_ai_deps.sh) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
